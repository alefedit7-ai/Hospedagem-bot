# BotNexus - copie este arquivo para ".env" (ou edite o arquivo variables.env).
# Nunca coloque tokens reais em arquivos que voce compartilha.

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Chave usada para criptografar tokens dos bots (minimo 32 caracteres).
# Se ficar vazia, o BotNexus gera uma chave sozinha em data/secret.key.
BOTNEXUS_SECRET=

# Coloque true quando o painel estiver atras de HTTPS.
COOKIE_SECURE=false

# Coloque true se estiver atras de proxy reverso (Nginx, Cloudflare etc.).
TRUST_PROXY=false

# Permitir novos cadastros.
ALLOW_REGISTRATION=true

# Limites de upload (em MB).
UPLOAD_MAX_MB=10
EXTRACT_MAX_MB=100
EXTRACT_MAX_FILES=5000

# Quantidade maxima de bots rodando ao mesmo tempo no servidor todo.
GLOBAL_MAX_RUNNING=20

# Execucao dos bots: "process" (processo restrito) ou "docker" (container).
BOT_RUNNER=process

# Restringe os arquivos que cada bot pode ler/escrever: auto, on ou off.
BOT_FS_SANDBOX=auto

# Imagem usada quando BOT_RUNNER=docker.
DOCKER_IMAGE=node:22-alpine
